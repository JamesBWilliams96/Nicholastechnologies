# Public origin of the deployed site, used for canonical URLs, Open Graph, JSON-LD, the sitemap and robots.txt.
# Optional: defaults to https://nicholastechnology.dev in production builds and http://localhost:3000 in development.
# Only set it if the domain changes. Include the scheme (https://).
NEXT_PUBLIC_SITE_URL=https://nicholastechnology.dev

# Optional public contact email. Shown in the footer and offered as a fallback if the enquiry form can't send.
NEXT_PUBLIC_CONTACT_EMAIL=

# Enquiry form delivery (optional). When both are set, enquiries are emailed via Resend (https://resend.com).
# Without them, the form still completes for the visitor and each enquiry is written to the server logs instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# The address Resend sends from. Must be on a domain verified in your Resend account.
CONTACT_FROM_EMAIL="Nicholas Technologies <enquiries@example.com>"
